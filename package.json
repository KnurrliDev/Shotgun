{
	"name": "shotgun",
	"displayName": "Shotgun",
	"description": "Pair programming with Claude Code in 6 stages: brief, survey, order, plan, build and review. You make the decisions, and you write the steps with the most risk.",
	"version": "0.4.0",
	"publisher": "KnurrliDev",
	"license": "MIT",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/KnurrliDev/Shotgun.git"
	},
	"homepage": "https://github.com/KnurrliDev/Shotgun#readme",
	"bugs": {
		"url": "https://github.com/KnurrliDev/Shotgun/issues"
	},
	"categories": [
		"AI",
		"Other"
	],
	"engines": {
		"vscode": "^1.143.0"
	},
	"extensionDependencies": [
		"KnurrliDev.dataflow"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"workspaceContains:.shotgun/active.json",
		"onWebviewPanel:shotgun.page"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "shotgun-sidebar",
					"title": "Shotgun",
					"icon": "media/shotgun.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "shotgun",
					"title": "Shotgun",
					"icon": "media/shotgun.svg"
				}
			]
		},
		"views": {
			"shotgun-sidebar": [
				{
					"id": "shotgun.home",
					"name": "Shotgun"
				}
			],
			"shotgun": [
				{
					"type": "webview",
					"id": "shotgun.panel",
					"name": "Shotgun"
				}
			]
		},
		"commands": [
			{
				"command": "shotgun.newTask",
				"title": "New Task",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.openTask",
				"title": "Open Task",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.returnToStage",
				"title": "Return to a Stage...",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showPanel",
				"title": "Show Panel",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showLog",
				"title": "Show Log",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.openProjectFolder",
				"title": "Open Project Folder...",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.openRecentProject",
				"title": "Open Recent Project...",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.pause",
				"title": "Pause",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.continue",
				"title": "Continue",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showPage",
				"title": "Show Page",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.openBrief",
				"title": "Open Brief",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.closeQuestion",
				"title": "Close Question",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.answerQuestion",
				"title": "Answer Question",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.checkHooks",
				"title": "Check the Hooks Again",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.setLevel",
				"title": "Set Risk Level",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.checkLevels",
				"title": "Check the Levels Again",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showStep",
				"title": "Show Step",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.markChange",
				"title": "Mark a Change",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.nextHole",
				"title": "Go to the Next Hole",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.previousHole",
				"title": "Go to the Hole Before",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.nextHint",
				"title": "Show the Next Hint",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.requestFrame",
				"title": "I Want a Frame",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.closeCallout",
				"title": "Not a Problem",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showInDataFlow",
				"title": "Show in DataFlow",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.setVoice",
				"title": "Set the Voice of the Callouts",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.resolveAnswer",
				"title": "Resolve a Question on a Line",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.handLooseEnd",
				"title": "Hand a Loose End to Claude",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.closeLooseEnd",
				"title": "Close a Loose End",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.showLedger",
				"title": "Show the Ledger",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.copyLedger",
				"title": "Copy the Ledger for a Pull Request",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.passGate",
				"title": "Pass the Gate",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.connectClaude",
				"title": "Connect to Claude Code",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.disconnectClaude",
				"title": "Disconnect from Claude Code",
				"category": "Shotgun"
			},
			{
				"command": "shotgun.checkForUpdates",
				"title": "Check for Updates",
				"category": "Shotgun"
			}
		],
		"configuration": {
			"title": "Shotgun",
			"properties": {
				"shotgun.voice": {
					"type": "string",
					"enum": [
						"quiet",
						"normal",
						"talkative"
					],
					"default": "normal",
					"enumDescriptions": [
						"Problems only, at each pause.",
						"Problems and warnings, in 1 batch at each pause.",
						"Each new fact of DataFlow on your lines, also the hidden C++."
					],
					"description": "The voice of the callouts: the kinds of the new facts of DataFlow that show on the lines that you write."
				},
				"shotgun.steOutput": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"description": "While a Shotgun task is active and not paused, Claude writes all text in ASD-STE100 Simplified Technical English (STE)."
				},
				"shotgun.pauseSeconds": {
					"type": "number",
					"default": 2,
					"minimum": 0.5,
					"maximum": 60,
					"description": "The time in seconds with no edit that makes a pause. Callouts come only at a pause, with a maximum of 3 for each pause."
				},
				"shotgun.update.mode": {
					"type": "string",
					"enum": [
						"auto",
						"ask",
						"off"
					],
					"enumDescriptions": [
						"Install a new version, then offer a reload of the window.",
						"Ask before Shotgun installs a new version.",
						"Do not look for new versions. The command Shotgun: Check for Updates still works."
					],
					"default": "auto",
					"scope": "application",
					"description": "How Shotgun gets a new version from its releases on GitHub. Shotgun installs only a package with a correct signature. If the setting extensions.autoUpdate is false, Shotgun asks first."
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "shotgun.returnToStage",
					"when": "shotgun.hasTask"
				},
				{
					"command": "shotgun.pause",
					"when": "shotgun.hasTask && !shotgun.isPaused"
				},
				{
					"command": "shotgun.continue",
					"when": "shotgun.hasTask && shotgun.isPaused"
				},
				{
					"command": "shotgun.openBrief",
					"when": "shotgun.hasTask"
				},
				{
					"command": "shotgun.closeQuestion",
					"when": "shotgun.hasQuestions"
				},
				{
					"command": "shotgun.answerQuestion",
					"when": "shotgun.hasSurveyQuestions"
				},
				{
					"command": "shotgun.checkHooks",
					"when": "shotgun.hasHooks"
				},
				{
					"command": "shotgun.setLevel",
					"when": "shotgun.canSetLevel"
				},
				{
					"command": "shotgun.checkLevels",
					"when": "shotgun.hasPlan"
				},
				{
					"command": "shotgun.showStep",
					"when": "false"
				},
				{
					"command": "shotgun.markChange",
					"when": "shotgun.hasReceipt"
				},
				{
					"command": "shotgun.nextHole",
					"when": "shotgun.hasHoles"
				},
				{
					"command": "shotgun.previousHole",
					"when": "shotgun.hasHoles"
				},
				{
					"command": "shotgun.nextHint",
					"when": "shotgun.hasHoles"
				},
				{
					"command": "shotgun.requestFrame",
					"when": "shotgun.canRequestFrame"
				},
				{
					"command": "shotgun.closeCallout",
					"when": "shotgun.hasCallouts"
				},
				{
					"command": "shotgun.showInDataFlow",
					"when": "false"
				},
				{
					"command": "shotgun.setVoice",
					"when": "shotgun.hasTask"
				},
				{
					"command": "shotgun.resolveAnswer",
					"when": "shotgun.hasAnswers"
				},
				{
					"command": "shotgun.handLooseEnd",
					"when": "shotgun.hasLooseEnds"
				},
				{
					"command": "shotgun.closeLooseEnd",
					"when": "shotgun.hasLooseEnds"
				},
				{
					"command": "shotgun.showLedger",
					"when": "shotgun.hasLedger"
				},
				{
					"command": "shotgun.copyLedger",
					"when": "shotgun.hasLedger"
				},
				{
					"command": "shotgun.passGate",
					"when": "shotgun.hasTask"
				}
			]
		},
		"keybindings": [
			{
				"command": "shotgun.nextHole",
				"key": "tab",
				"when": "editorTextFocus && shotgun.inFrame && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus && !renameInputVisible && !parameterHintsVisible"
			},
			{
				"command": "shotgun.previousHole",
				"key": "shift+tab",
				"when": "editorTextFocus && shotgun.inFrame && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus && !renameInputVisible && !parameterHintsVisible"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json && node scripts/build-webviews.mjs",
		"watch": "node scripts/build-webviews.mjs --watch",
		"pretest": "npm run compile",
		"test": "vscode-test",
		"package": "node scripts/package-vsix.mjs"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "1.120.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"preact": "^11.0.2",
		"typescript": "^6.0.3"
	}
}
